# Local: PGlite en .data/leytech. Producción: PostgreSQL externo obligatorio.
DATABASE_URL=
DATABASE_SSL=true
PGLITE_PATH=.data/leytech
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# live o sandbox. No se habilitan cobros sin estas credenciales.
MERCADOPAGO_MODE=sandbox
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_COLLECTOR_ID=
# Bucket privado de fotografías públicas del catálogo. Clave solo en servidor.
STORAGE_SUPABASE_URL=
STORAGE_SERVICE_ROLE_KEY=
STORAGE_BUCKET=leytech-products
# Usar únicamente detrás de un proxy propio que reescriba X-Forwarded-For.
TRUST_PROXY=false
